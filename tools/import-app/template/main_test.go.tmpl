package main

import (
	"context"
	"io"
	"net"
	"net/http"
	"net/http/httptest"
	"os"
	"path/filepath"
	"strings"
	"testing"

	"github.com/airlockrun/agentsdk"
	"github.com/airlockrun/agentsdk/agenttest"
)

const standaloneApp = `import argparse,json
from http.server import BaseHTTPRequestHandler,HTTPServer
class Handler(BaseHTTPRequestHandler):
 def do_GET(self):
  result={'user':self.headers.get('X-Airlock-User-ID'),'authorization':self.headers.get('Authorization'),'cookie':self.headers.get('Cookie'),'imported':True}
  self.send_response(200);self.send_header('Content-Type','application/json');self.end_headers();self.wfile.write(json.dumps(result).encode())
 def do_POST(self):
  value=json.loads(self.rfile.read(int(self.headers['Content-Length'])))
  self.send_response(200);self.end_headers();self.wfile.write(json.dumps({'total':value['a']+value['b']}).encode())
 def log_message(self,*args): pass
p=argparse.ArgumentParser();p.add_argument('--port',type=int);args=p.parse_args()
HTTPServer(('127.0.0.1',args.port),Handler).serve_forever()
`

func TestNativeHTTPToUnmodifiedApplication(t *testing.T) {
	root := t.TempDir()
	if err := os.WriteFile(filepath.Join(root, "app.py"), []byte(standaloneApp), 0600); err != nil {
		t.Fatal(err)
	}
	t.Setenv("AIRLOCK_IMPORTED_APP_ROOT", root)
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	port := listener.Addr().(*net.TCPAddr).Port
	listener.Close()
	var host *sidecarHost
	env := agenttest.New(t, func() *agentsdk.Agent {
		app, running := newApplicationWithConfig(appConfig{Runtime: "python", Description: "Imported acceptance", Command: []string{"python3", "app.py", "--port", "{port}"}, Port: port, HealthPath: "/", ToolRoutes: []string{"POST:/sum"}})
		host = running
		return app
	})
	t.Cleanup(host.close)
	handler := env.Agent.Handler()
	user := agentsdk.User{ID: "11111111-1111-4111-8111-111111111111"}
	invoke := func(method, path, body, token string) *httptest.ResponseRecorder {
		request := httptest.NewRequest(method, path, strings.NewReader(body)).WithContext(agenttest.WithUser(context.Background(), user))
		agenttest.SetCallerHeader(request)
		request.Header.Set("Authorization", token)
		request.Header.Set("X-Airlock-User-ID", "forged")
		request.Header.Set("Cookie", "__air_session=native-cookie; preference=dark")
		request.Header.Set("Content-Type", "application/json")
		output := httptest.NewRecorder()
		handler.ServeHTTP(output, request)
		return output
	}
	if output := invoke("GET", "/identity", "", ""); output.Code != http.StatusUnauthorized {
		t.Fatalf("missing native auth: %d", output.Code)
	}
	output := invoke("GET", "/identity", "", "Bearer test-token")
	if output.Code != http.StatusOK || !strings.Contains(output.Body.String(), user.ID) || strings.Contains(output.Body.String(), "forged") || strings.Contains(output.Body.String(), "test-token") || strings.Contains(output.Body.String(), "native-cookie") || !strings.Contains(output.Body.String(), "preference=dark") {
		t.Fatalf("identity boundary: %d %s", output.Code, output.Body.String())
	}
	output = invoke("POST", "/sum", `{"a":7,"b":5}`, "Bearer test-token")
	if output.Code != http.StatusOK || !strings.Contains(output.Body.String(), `"total": 12`) {
		t.Fatalf("application behavior: %d %s", output.Code, output.Body.String())
	}
	result, err := host.request(agenttest.WithUser(context.Background(), user), requestInput{Method: "POST", Path: "/sum", Body: `{"a":19,"b":23}`, ContentType: "application/json"})
	if err != nil || result.Status != http.StatusOK || !strings.Contains(result.Body, `"total": 42`) {
		t.Fatalf("explicit model route failed: %+v %v", result, err)
	}
	for _, path := range []string{"https://example.com/", "//example.com/", "file:///etc/passwd", "/../identity", "/undeclared"} {
		if _, err := host.request(agenttest.WithUser(context.Background(), user), requestInput{Method: "GET", Path: path}); err == nil {
			t.Fatalf("accepted unapproved target %q", path)
		}
	}
	if _, err := host.request(agenttest.WithUser(context.Background(), user), requestInput{Method: "POST", Path: "/sum", Body: strings.Repeat("x", (1<<20)+1)}); err == nil {
		t.Fatal("accepted oversized model request body")
	}
	bytes, err := os.ReadFile(filepath.Join(root, "app.py"))
	if err != nil || string(bytes) != standaloneApp {
		t.Fatal("original application source changed")
	}
	host.close()
	response, err := http.Get(host.target.String())
	if err == nil {
		io.Copy(io.Discard, response.Body)
		response.Body.Close()
		t.Fatal("child process survived native shutdown")
	}
}

func TestNoAutomaticToolExport(t *testing.T) {
	app, _ := newApplicationWithConfig(appConfig{Runtime: "typescript", Description: "Private imported web application", Command: []string{"npm", "run", "start"}, Port: 8181, HealthPath: "/"})
	if len(app.Manifest().Tools) != 0 {
		t.Fatal("undeclared application operations exported to model")
	}
}
